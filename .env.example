# Copy the values you need to ~/.config/instagram-to-value/secrets.env.
# That external file is intentionally never read from this repository.

# Telegram bot used only by the dedicated, allowlisted ingest interface.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# Optional extraction fallbacks. The pipeline uses these only when invoked.
GROQ_API_KEY=
GEMINI_API_KEY=
OCRSPACE_API_KEY=
